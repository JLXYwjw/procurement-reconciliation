            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.0factdetail].[none:tier_cn:nk]' />
              <text column='[federated.0factdetail].[sum:spend_b:qk]' />
