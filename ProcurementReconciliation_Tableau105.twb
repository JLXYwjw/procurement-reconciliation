    <worksheet name='6 供应商散点'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f4e79' fontname='Microsoft YaHei' fontsize='15'>500 家供应商覆盖 92.7% 支出，其中 5 家只下过 1 单</run>
            <run fontcolor='#7f7f7f' fontname='Microsoft YaHei' fontsize='9'>&#10;这 5 家单笔合计 $13.0B · 每点一家供应商 · X=订单数 Y=总支出</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Top500供应商' name='federated.0supplier' />
          </datasources>
          <datasource-dependencies datasource='federated.0supplier'>
            <column datatype='integer' name='[order_count]' role='measure' type='quantitative' />
            <column-instance column='[order_count]' derivation='Sum' name='[sum:order_count:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[total_spend_b]' role='measure' type='quantitative' />
            <column-instance column='[total_spend_b]' derivation='Sum' name='[sum:total_spend_b:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[supplier_name]' role='dimension' type='nominal' />
            <column-instance column='[supplier_name]' derivation='None' name='[none:supplier_name:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[tier_cn]' role='dimension' type='nominal' />
            <column-instance column='[tier_cn]' derivation='None' name='[none:tier_cn:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='pane'>
            <format attr='border-style' scope='rows' value='none' />
            <format attr='border-style' scope='cols' value='none' />
          </style-rule>
          <style-rule element='header'>
            <format attr='border-style' scope='rows' value='none' />
            <format attr='border-style' scope='cols' value='none' />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-pattern' scope='rows' value='none' />
            <format attr='line-pattern' scope='cols' value='none' />
          </style-rule>
          <style-rule element='header-div'>
            <format attr='line-pattern' scope='rows' value='none' />
            <format attr='line-pattern' scope='cols' value='none' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.0supplier].[sum:total_spend_b:qk]' value='*0.00' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
            <format attr='color' value='#333333' />
          </style-rule>
          <style-rule element='field-labels'>
            <format attr='font-family' value='Microsoft YaHei' />
          </style-rule>
          <style-rule element='axis'>
            <format attr='title' class='0' scope='cols' value='订单数' />
            <format attr='title' class='0' scope='rows' value='总支出（十亿美元）' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <color column='[federated.0supplier].[none:tier_cn:nk]' />
              <lod column='[federated.0supplier].[none:supplier_name:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.0supplier].[sum:total_spend_b:qk]</rows>
        <cols>[federated.0supplier].[sum:order_count:qk]</cols>
      </table>
    </worksheet>
